   "source": [
    "import matplotlib.pyplot as plt\n",
    "import pandas as pd\n",
    "\n",
    "data = pd.read_csv('data/pm25_simpletest.csv')\n",
    "\n",
    "pm25 = data['particles 25um']\n",
    "\n",
    "plt.hist(pm25, bins=3)\n",
    "plt.xlabel('Pm 2.5um values')\n",
    "plt.ylabel('Frequency')\n",
    "plt.title('Pm 2.5um Histogram')\n",
    "plt.show()"
   ]
  }
 ],
